# ---------------------------------------------------------------------------
# Copy this file to .env  (cp .env.example .env) and edit the values.
# The values below are DEVELOPMENT-ONLY placeholders. Never commit the real .env
# file and never reuse these passwords on a public deployment.
# ---------------------------------------------------------------------------

# Port the Express server listens on
PORT=3000

# Where the SQLite database file is created (relative to the project root)
DB_PATH=./data/timetable.db

# Secret used to sign the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-development-secret

# Seeded administrator account (created by: npm run db:seed)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=Admin@1234

# Seeded timetable officer account
DEFAULT_OFFICER_USERNAME=officer
DEFAULT_OFFICER_PASSWORD=Officer@1234

# Seeded read-only viewer account
DEFAULT_VIEWER_USERNAME=viewer
DEFAULT_VIEWER_PASSWORD=Viewer@1234

# development | production
NODE_ENV=development
