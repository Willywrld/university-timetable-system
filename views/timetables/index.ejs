<%- include('../partials/header') %>

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
  <div>
    <h1 class="h3 mb-0">Timetable</h1>
    <p class="text-muted small mb-0"><%= rows.length %> scheduled activity(ies) match the current filter.</p>
  </div>
  <div class="d-print-none">
    <a class="btn btn-outline-secondary btn-sm" href="/timetables">Reset filters</a>
    <a class="btn btn-success btn-sm" href="/timetables/export.csv?<%= new URLSearchParams(Object.entries(filters).filter(([, value]) => value)).toString() %>">Export CSV</a>
    <a class="btn btn-outline-primary btn-sm" href="#" onclick="window.print(); return false;">Print</a>
  </div>
</div>

<div class="card shadow-sm mb-4 d-print-none">
  <div class="card-body">
    <form method="get" action="/timetables" class="row g-2 align-items-end">
      <div class="col-md-3">
        <label class="form-label small" for="category">Category</label>
        <select class="form-select form-select-sm" id="category" name="category">
          <option value="">All categories</option>
          <% reference.types.forEach(function (type) { %>
            <option value="<%= type.code %>" <%= filters.category === type.code ? 'selected' : '' %>><%= type.name %></option>
          <% }); %>
        </select>
      </div>
      <div class="col-md-3">
        <label class="form-label small" for="q">Search</label>
        <input class="form-control form-control-sm" id="q" name="q" value="<%= filters.q %>" placeholder="Course, venue or facilitator">
      </div>
      <div class="col-md-2">
        <label class="form-label small" for="programme_id">Programme</label>
        <select class="form-select form-select-sm" id="programme_id" name="programme_id">
          <option value="">All</option>
          <% reference.programmes.forEach(function (programme) { %>
            <option value="<%= programme.id %>" <%= String(filters.programme_id) === String(programme.id) ? 'selected' : '' %>><%= programme.name %></option>
          <% }); %>
        </select>
      </div>
      <div class="col-md-2">
        <label class="form-label small" for="level_id">Level</label>
        <select class="form-select form-select-sm" id="level_id" name="level_id">
          <option value="">All</option>
          <% reference.levels.forEach(function (level) { %>
            <option value="<%= level.id %>" <%= String(filters.level_id) === String(level.id) ? 'selected' : '' %>><%= level.level_number %></option>
          <% }); %>
        </select>
      </div>
      <div class="col-md-2">
        <label class="form-label small" for="course_id">Course</label>
        <select class="form-select form-select-sm" id="course_id" name="course_id">
          <option value="">All</option>
          <% reference.courses.forEach(function (course) { %>
            <option value="<%= course.id %>" <%= String(filters.course_id) === String(course.id) ? 'selected' : '' %>><%= course.course_code %></option>
          <% }); %>
        </select>
      </div>
      <div class="col-md-2">
        <label class="form-label small" for="date_from">From</label>
        <input class="form-control form-control-sm" type="date" id="date_from" name="date_from" value="<%= filters.date_from %>">
      </div>
      <div class="col-md-2">
        <label class="form-label small" for="date_to">To</label>
        <input class="form-control form-control-sm" type="date" id="date_to" name="date_to" value="<%= filters.date_to %>">
      </div>
      <div class="col-md-3">
        <label class="form-label small" for="venue_id">Venue</label>
        <select class="form-select form-select-sm" id="venue_id" name="venue_id">
          <option value="">All</option>
          <% reference.venues.forEach(function (venue) { %>
            <option value="<%= venue.id %>" <%= String(filters.venue_id) === String(venue.id) ? 'selected' : '' %>><%= venue.name %> (<%= venue.centre %>)</option>
          <% }); %>
        </select>
      </div>
      <div class="col-md-3">
        <label class="form-label small" for="platform_id">Platform</label>
        <select class="form-select form-select-sm" id="platform_id" name="platform_id">
          <option value="">All</option>
          <% reference.platforms.forEach(function (platform) { %>
            <option value="<%= platform.id %>" <%= String(filters.platform_id) === String(platform.id) ? 'selected' : '' %>><%= platform.name %></option>
          <% }); %>
        </select>
      </div>
      <div class="col-md-2">
        <button class="btn btn-primary btn-sm w-100" type="submit">Apply</button>
      </div>
    </form>
  </div>
</div>

<div class="card shadow-sm">
  <div class="card-body table-responsive">
    <table class="table table-sm table-striped align-middle mb-0">
      <thead>
        <tr>
          <th>Date</th><th>Time</th><th>Category</th><th>Course</th><th>Facilitator</th>
          <th>Group</th><th>Venue / Platform</th><th>Centre</th><th>Candidates</th><th class="d-print-none"></th>
        </tr>
      </thead>
      <tbody>
        <% if (!rows.length) { %>
          <tr><td colspan="10" class="text-muted">No scheduled activities match this filter.</td></tr>
        <% } %>
        <% rows.forEach(function (row) { %>
          <tr>
            <td><%= row.date %></td>
            <td><%= row.start_time %>&ndash;<%= row.end_time %></td>
            <td><span class="badge bg-secondary"><%= row.type_name %></span></td>
            <td><strong><%= row.course_code %></strong><div class="small text-muted"><%= row.course_title %></div></td>
            <td><%= row.facilitator_name || '-' %></td>
            <td><%= row.group_name || '-' %></td>
            <td>
              <%= row.venue_name || '-' %>
              <% if (row.platform_name) { %><div class="small text-muted"><%= row.platform_name %></div><% } %>
            </td>
            <td><%= row.centre || row.venue_centre || '-' %></td>
            <td>
              <%= row.expected_candidates || '-' %>
              <% if (row.exam_format) { %><div class="small text-muted"><%= row.exam_format %></div><% } %>
            </td>
            <td class="d-print-none">
              <% if (currentUser.role !== 'viewer') { %>
                <a class="btn btn-sm btn-outline-primary" href="/timetables/<%= row.id %>/edit">Edit</a>
              <% } %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/footer') %>
