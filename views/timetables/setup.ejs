<%- include('../partials/header') %>

<h1 class="h3 mb-1">Timetable Setup</h1>
<p class="text-muted small mb-3">Resources and categories available before generation.</p>

<div class="row g-3 mb-4">
  <% [['Time slots', counts.slots], ['Active venues', counts.venues], ['Active platforms', counts.platforms], ['Pending requests', counts.requests]].forEach(function (card) { %>
    <div class="col-6 col-md-3">
      <div class="card stat-card h-100 shadow-sm">
        <div class="card-body py-3">
          <div class="stat-value"><%= card[1] %></div>
          <div class="text-muted small"><%= card[0] %></div>
        </div>
      </div>
    </div>
  <% }); %>
</div>

<div class="card shadow-sm mb-4">
  <div class="card-header">Timetable categories</div>
  <div class="card-body table-responsive">
    <table class="table table-sm align-middle mb-0">
      <thead><tr><th>Category</th><th>Description</th><th>Scheduled</th><th>Pending</th><th>Unassigned</th><th class="d-print-none"></th></tr></thead>
      <tbody>
        <% perType.forEach(function (row) { %>
          <tr>
            <td><strong><%= row.name %></strong><div class="small text-muted"><%= row.code %></div></td>
            <td class="small"><%= row.description %></td>
            <td><%= row.scheduled || 0 %></td>
            <td><%= row.pending || 0 %></td>
            <td><%= row.unassigned || 0 %></td>
            <td class="d-print-none">
              <a class="btn btn-sm btn-outline-primary" href="/timetables/generate?category=<%= row.code %>">Generate</a>
              <a class="btn btn-sm btn-outline-secondary" href="/timetables?category=<%= row.code %>">View</a>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<div class="card shadow-sm">
  <div class="card-header">Master data shortcuts</div>
  <div class="card-body d-flex flex-wrap gap-2">
    <a class="btn btn-outline-secondary btn-sm" href="/admin/slots">Time slots</a>
    <a class="btn btn-outline-secondary btn-sm" href="/admin/venues">Venues</a>
    <a class="btn btn-outline-secondary btn-sm" href="/admin/platforms">Platforms</a>
    <a class="btn btn-outline-secondary btn-sm" href="/admin/facilitators">Facilitators</a>
    <a class="btn btn-outline-secondary btn-sm" href="/admin/courses">Courses</a>
    <a class="btn btn-outline-secondary btn-sm" href="/admin/groups">Student groups</a>
  </div>
</div>

<%- include('../partials/footer') %>
