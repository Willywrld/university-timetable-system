<%- include('../partials/header') %>

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
  <div>
    <h1 class="h3 mb-0">Conflict Report</h1>
    <p class="text-muted small mb-0">
      <%= summary.total %> open conflict(s) &middot; <%= summary.hard %> hard &middot; <%= summary.warning %> warning
    </p>
  </div>
  <div class="d-print-none">
    <% if (canResolve) { %>
      <form method="post" action="/conflicts/run" class="d-inline">
        <button class="btn btn-outline-primary btn-sm" type="submit">Re-run full check</button>
      </form>
    <% } %>
    <a class="btn btn-outline-secondary btn-sm" href="#" onclick="window.print(); return false;">Print</a>
  </div>
</div>

<div class="card shadow-sm">
  <div class="card-body p-0">
    <% if (!conflicts.length) { %>
      <p class="text-muted p-3 mb-0">No open conflicts. Re-run the check after making changes.</p>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
          <thead>
            <tr><th>#</th><th>Type</th><th>Severity</th><th>Activity</th><th>Message</th><th>Suggested fix</th><th class="d-print-none"></th></tr>
          </thead>
          <tbody>
            <% conflicts.forEach(function (conflict) { %>
              <tr>
                <td><%= conflict.id %></td>
                <td><span class="badge bg-dark"><%= conflict.conflict_type %></span></td>
                <td>
                  <span class="badge <%= conflict.severity === 'hard' ? 'badge-severity-hard' : 'badge-severity-warning' %>"><%= conflict.severity %></span>
                </td>
                <td class="small">
                  assignments <%= conflict.assignmentIds.join(', ') %><br>
                  <span class="text-muted"><%= conflict.course_code %> &middot; <%= conflict.date || 'no date' %> <%= conflict.start_time || '' %></span>
                </td>
                <td class="small"><%= conflict.message %></td>
                <td class="small text-muted"><%= conflict.suggested_fix %></td>
                <td class="d-print-none">
                  <% if (canResolve) { %>
                    <a class="btn btn-sm btn-outline-primary" href="/timetables/<%= conflict.assignment_id %>/edit">Fix</a>
                    <form method="post" action="/conflicts/<%= conflict.id %>/resolve" class="d-inline" onsubmit="return confirm('Mark this conflict as resolved?');">
                      <button class="btn btn-sm btn-outline-success" type="submit">Resolve</button>
                    </form>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
