<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> &middot; UIDLC Timetable System</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark d-print-none">
  <div class="container-fluid">
    <a class="navbar-brand" href="/dashboard">UIDLC Timetable</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="mainNav">
      <% if (currentUser) { %>
        <ul class="navbar-nav me-auto">
          <li class="nav-item"><a class="nav-link" href="/dashboard">Dashboard</a></li>
          <li class="nav-item"><a class="nav-link" href="/timetables">Timetable</a></li>
          <% if (currentUser.role !== 'viewer') { %>
            <li class="nav-item"><a class="nav-link" href="/timetables/generate">Generate</a></li>
            <li class="nav-item"><a class="nav-link" href="/timetables/new">New activity</a></li>
            <li class="nav-item"><a class="nav-link" href="/timetables/setup">Setup</a></li>
            <li class="nav-item"><a class="nav-link" href="/conflicts">Conflicts</a></li>
          <% } %>
          <% if (currentUser.role === 'admin') { %>
            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle" href="#" id="masterMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">Master data</a>
              <ul class="dropdown-menu" aria-labelledby="masterMenu">
                <li><a class="dropdown-item" href="/admin/programmes">Programmes</a></li>
                <li><a class="dropdown-item" href="/admin/levels">Levels</a></li>
                <li><a class="dropdown-item" href="/admin/courses">Courses</a></li>
                <li><a class="dropdown-item" href="/admin/groups">Student groups</a></li>
                <li><a class="dropdown-item" href="/admin/facilitators">Facilitators</a></li>
                <li><a class="dropdown-item" href="/admin/venues">Venues</a></li>
                <li><a class="dropdown-item" href="/admin/platforms">Platforms</a></li>
                <li><a class="dropdown-item" href="/admin/slots">Time slots</a></li>
              </ul>
            </li>
            <li class="nav-item"><a class="nav-link" href="/users">Users</a></li>
          <% } %>
        </ul>
        <span class="navbar-text text-white-50 me-3 small">
          <%= currentUser.full_name %> &middot; <%= currentUser.role %>
        </span>
        <form method="post" action="/logout" class="d-flex">
          <button class="btn btn-sm btn-outline-light" type="submit">Log out</button>
        </form>
      <% } %>
    </div>
  </div>
</nav>
<main class="container py-4">
  <% if (flash) { %>
    <div class="alert alert-<%= flash.type %> alert-dismissible fade show" role="alert">
      <%= flash.message %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>
